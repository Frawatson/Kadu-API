# Copy to `.env` and adjust as needed. `.env` is gitignored.

# Postgres — matches docker-compose.yml's published port (5433).
DATABASE_URL="postgresql://kadu:kadu@localhost:5433/kadu?schema=public"

# JWT signing key. Any non-empty string works for local dev — set to
# something proper for any non-local deploy.
JWT_SECRET="dev-only-secret-change-me"

# API port (frontend dev expects 3003).
PORT=3003

# CORS origin allowed to call the API. The Vite frontend runs on 3002.
CORS_ORIGIN="http://localhost:3002"
